# Port the server listens on
PORT=3000

# URL of the frontend client (used for CORS). In this project the server
# also serves the client statically, so this is mainly useful when you
# host the frontend separately (e.g. Netlify) and the backend elsewhere.
CLIENT_URL=http://localhost:3000

# Maximum size, in megabytes, allowed for a single uploaded file
MAX_FILE_SIZE_MB=50

# How many minutes a room stays alive before it (and its files) are deleted
ROOM_EXPIRY_MINUTES=15

# Maximum number of participants allowed in a single room (sender + receivers)
MAX_ROOM_USERS=2

# Node environment: development | production
NODE_ENV=development
